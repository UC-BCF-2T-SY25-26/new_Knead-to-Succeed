MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 110637134}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 181587d0670c8c14f8a63128e25108cd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialText: {fileID: 979043509}
  tutorialPanel: {fileID: 186737068}
  steps:
  - Use the WASD keys on your keyboard to navigate around the shop.
  - "Hold left click to drag the flour, yeast, and eggs into the bowl. \t"
  - 'Drag the bowl to the mixer. '
  - 'Wait for the dough to finish mixing.  '
  - 'Click the arrow to head to the next station. '
  - 'Click on the rolling pin to flatten the dough out. '
  - 'Click on the knife to cut the dough into 6 pieces.  '
  - 'Click the arrow to head to the next station. '
  - 'Click on the pastry brush to add melted butter unto the tray.  '
  - Click on the pieces of sliced dough to add them unto the tray.
  - Click the arrow to head to the next station.
  - 'Place the tray of bread into the oven. '
  - 'Wait for the bread to bake. '
  - 'Click on the oven to take the pandesal out. '
  - Click the arrow to head to the next station.
  - 'Click on the bread rack to display the pieces of pandesal. '
  - 'Click on the arrow to wait for your first customer. '
